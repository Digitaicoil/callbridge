# Copy to .env (or ~/.config/callbridge/.env) and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
ELEVENLABS_API_KEY=                 # elevenlabs.io → Settings → API keys (needs Conversational AI access)
CALLBRIDGE_INBOUND_AGENT_ID=        # printed by: callbridge agent create receptionist ...
CALLBRIDGE_OUTBOUND_AGENT_ID=       # printed by: callbridge agent create sales ...

# --- Where finished calls go (any mix) -------------------------------------
CALLBRIDGE_SINKS=jsonl              # jsonl,telegram,slack,webhook,hubspot

# telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=                 # optional: a forum topic in a group

# slack
SLACK_WEBHOOK_URL=

# webhook: Zapier / Make / n8n / your CRM's automation / your backend
CALLBRIDGE_WEBHOOK_URL=
CALLBRIDGE_WEBHOOK_SECRET=          # optional, sent as X-CallBridge-Secret

# hubspot: private app token with crm.objects.contacts.read + write
HUBSPOT_TOKEN=

# --- Tuning (defaults are fine) --------------------------------------------
# CALLBRIDGE_RECORD=0               # 1 = save a stereo WAV of every call (check your local law on call recording)
# CALLBRIDGE_CALL_GAIN=12           # the call audio arrives quiet; this lifts it for the agent
# CALLBRIDGE_MAX_CALL_SECONDS=600
# CALLBRIDGE_SILENCE_HANGUP_SECONDS=6
# CALLBRIDGE_ACCEPT_LABELS=Accept,Answer   # the incoming-call button names in your macOS language
# CALLBRIDGE_IPHONE_UDID=           # only if you run Appium/WebDriverAgent on the iPhone (see docs/troubleshooting.md)
# CALLBRIDGE_CALL_DEVICE=CallBridgeCall 2ch
# CALLBRIDGE_AGENT_DEVICE=CallBridgeAgent 2ch
# CALLBRIDGE_DATA_DIR=~/Library/Logs/callbridge
# CALLBRIDGE_DNC_FILE=~/.config/callbridge/do-not-call.txt
